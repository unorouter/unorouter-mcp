{
  "name": "unorouter-mcp",
  "version": "0.2.2",
  "description": "MCP server for UnoRouter: search 200+ models (most free), check pricing, and chat through one OpenAI-compatible key",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "unorouter-mcp": "dist/index.js",
    "unorouter-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && bun build src/index.ts src/http.ts --target node --outdir dist && chmod +x dist/index.js dist/http.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unorouter/unorouter-mcp.git"
  },
  "homepage": "https://unorouter.com",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "unorouter",
    "llm",
    "ai-gateway",
    "openai-compatible",
    "free-models"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "com.unorouter/mcp"
}
